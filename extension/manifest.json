{
  "manifest_version": 3,
  "name": "AgenticAxelor Session Sync",
  "version": "1.0.0",
  "description": "Synchronise la session Axelor active avec le serveur AgenticAxelor local.",
  "permissions": [
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:3210/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Synchroniser la session Axelor",
    "default_popup": "popup.html"
  }
}
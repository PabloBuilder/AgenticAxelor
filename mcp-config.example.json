{
  "mcpServers": {
    "agentic-axelor": {
      "command": "node",
      "args": [
        "<ABSOLUTE_PATH_TO_PROJECT>/dist/index.js"
      ],
      "env": {
        "AXELOR_URL": "<YOUR_AXELOR_URL>",
        "AXELOR_USERNAME": "<YOUR_AXELOR_USERNAME>",
        "AXELOR_PASSWORD": "<YOUR_AXELOR_PASSWORD>",
        "BRIDGE_PORT": "3210"
      }
    },
    "agentic-axelor-dev": {
      "command": "npx",
      "args": [
        "-y",
        "tsx",
        "<ABSOLUTE_PATH_TO_PROJECT>/src/index.ts"
      ],
      "env": {
        "AXELOR_URL": "<YOUR_AXELOR_URL>",
        "AXELOR_USERNAME": "<YOUR_AXELOR_USERNAME>",
        "AXELOR_PASSWORD": "<YOUR_AXELOR_PASSWORD>",
        "BRIDGE_PORT": "3210"
      }
    }
  }
}

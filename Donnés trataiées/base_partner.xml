<?xml version="1.0" encoding="UTF-8"?>
<csv-inputs xmlns="http://axelor.com/xml/ns/data-import"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/data-import https://axelor.com/xml/ns/data-import/data-import_8.2.xsd">

  <!-- 1. Import des Adresses -->
  <input file="base_address.csv" separator=";" type="com.axelor.apps.base.db.Address" search="self.importId = :importId">
    <bind to="importId" column="importId"/>
    <bind to="streetName" column="streetName"/>
    <bind to="zip" column="zip"/>
    <bind to="cityName" column="cityName"/>
    <bind to="country" eval="__repo__(Country).all().filter('self.alpha3Code = ?', country_alpha3Code).fetchOne()">
      <bind to="country_alpha3Code" column="country.alpha3Code"/>
    </bind>
  </input>

  <!-- 2. Import des Clients (Tiers) -->
  <input file="base_partner.csv" separator=";" type="com.axelor.apps.base.db.Partner" search="self.importId = :importId">
    <bind to="importId" column="importId"/>
    <bind to="name" column="name"/>
    <bind to="isCustomer" eval="true"/>
    <bind to="isContact" eval="false"/>
    <bind to="isSupplier" eval="false"/>
    <bind to="partnerTypeSelect" eval="partnerTypeSelect ? Integer.parseInt(partnerTypeSelect) : 1"/>
    <bind to="fixedPhone" column="fixedPhone"/>

    <!-- Association à la Société via le repo -->
    <bind to="companySet" eval="[__repo__(Company).all().fetchOne()] as Set"/>

    <!-- Adresse email (One-to-One) -->
    <bind to="emailAddress.address" column="email" if="email &amp;&amp; !email.trim().isEmpty()"/>

    <!-- Table de liaison PartnerAddress -->
    <bind to="partnerAddressList" if="address &amp;&amp; !address.trim().isEmpty()">
      <bind to="isDefaultAddr" eval="true"/>
      <bind to="isInvoicingAddr" eval="true"/>
      <bind to="isDeliveryAddr" eval="true"/>
      <bind to="address" eval="__repo__(Address).all().filter('self.importId = ?', address).fetchOne()"/>
    </bind>
  </input>

</csv-inputs>
